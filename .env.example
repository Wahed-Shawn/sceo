# GridWise environment configuration.
# Copy to .env and fill in.

# LLM provider: choose "openai" (default, required by the challenge) or "rules".
# "rules" is a deterministic resilience fallback used only when no API key is
# configured or a live model call fails -- it is NOT the primary interpreter.
GRIDWISE_LLM_MODE=openai

# OpenAI-compatible chat completions credentials.
# OpenAI: OPENAI_API_KEY=sk-...
# Google Gemini (validated): OPENAI_API_KEY=AIza... | AQ....
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   GRIDWISE_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Model id(s) used for operator-note interpretation.
# Comma-separated for automatic failover: try first, switch to next if no
# response within GRIDWISE_LLM_TIMEOUT seconds.
GRIDWISE_MODEL=gpt-4o-mini
# GRIDWISE_MODELS=gemini-2.5-flash-lite,gemini-3.1-flash-lite

# Seconds to wait for a model before switching to the next one (default 3).
GRIDWISE_LLM_TIMEOUT=3.0

# Service port.
PORT=8000